<?xml version="1.0"?>
<sdf version="1.10">
    <!--
      涵洞场景：
      - 长度方向改为 X 轴，总长 12m（x: -6.0 ~ 6.0）
      - 净宽 4m（y: -2.0 ~ 2.0），净高 2m（z: 0.0 ~ 2.0）
      - 两侧墙各厚 0.2m，不封底/不封顶/两端开口
      - 墙体内嵌若干盒状/圆柱特征物，只向通道内突出约 0.08~0.10m
    -->
    <model name="culvert">
        <static>true</static>
        <link name="culvert_walls_link">
            <!-- 下侧墙（y < 0）：长 12m 沿 X，厚 0.2m 沿 Y，高 2m 沿 Z -->
            <collision name="lower_wall_collision">
                <pose>0 -2.1 1.0 0 0 0</pose>
                <geometry>
                    <box><size>12.0 0.2 2.0</size></box>
                </geometry>
            </collision>
            <visual name="lower_wall_visual">
                <pose>0 -2.1 1.0 0 0 0</pose>
                <geometry>
                    <box><size>12.0 0.2 2.0</size></box>
                </geometry>
                <material>
                    <ambient>0.35 0.35 0.35 1</ambient>
                    <diffuse>0.65 0.65 0.65 1</diffuse>
                </material>
            </visual>

            <!-- 上侧墙（y > 0）：与下侧墙对称，中间净宽 4m -->
            <collision name="upper_wall_collision">
                <pose>0 2.1 1.0 0 0 0</pose>
                <geometry>
                    <box><size>12.0 0.2 2.0</size></box>
                </geometry>
            </collision>
            <visual name="upper_wall_visual">
                <pose>0 2.1 1.0 0 0 0</pose>
                <geometry>
                    <box><size>12.0 0.2 2.0</size></box>
                </geometry>
                <material>
                    <ambient>0.35 0.35 0.35 1</ambient>
                    <diffuse>0.65 0.65 0.65 1</diffuse>
                </material>
            </visual>

            <!-- ================= 下侧墙特征物 ================= -->
            <!-- 下侧特征 1：盒状凸起，x=-5.0m，向通道内突出 0.10m -->
            <collision name="lower_feature_box_1_collision">
                <pose>-5.0 -2.05 0.25 0 0 0</pose>
                <geometry>
                    <box><size>0.40 0.30 0.25</size></box>
                </geometry>
            </collision>
            <visual name="lower_feature_box_1_visual">
                <pose>-5.0 -2.05 0.25 0 0 0</pose>
                <geometry>
                    <box><size>0.40 0.30 0.25</size></box>
                </geometry>
                <material>
                    <ambient>0.35 0.35 0.30 1</ambient>
                    <diffuse>0.75 0.75 0.60 1</diffuse>
                </material>
            </visual>

            <!-- 下侧特征 2：竖圆柱，x=-1.8m，半径 0.08m，向通道内突出 0.08m -->
            <collision name="lower_feature_cylinder_2_collision">
                <pose>-1.8 -2.0 0.25 0 0 0</pose>
                <geometry>
                    <cylinder><radius>0.08</radius><length>0.25</length></cylinder>
                </geometry>
            </collision>
            <visual name="lower_feature_cylinder_2_visual">
                <pose>-1.8 -2.0 0.25 0 0 0</pose>
                <geometry>
                    <cylinder><radius>0.08</radius><length>0.25</length></cylinder>
                </geometry>
                <material>
                    <ambient>0.30 0.35 0.30 1</ambient>
                    <diffuse>0.60 0.75 0.60 1</diffuse>
                </material>
            </visual>

            <!-- 下侧特征 3：盒状凸起，x=1.2m，向通道内突出 0.10m -->
            <collision name="lower_feature_box_3_collision">
                <pose>1.2 -2.05 0.30 0 0 0</pose>
                <geometry>
                    <box><size>0.55 0.30 0.35</size></box>
                </geometry>
            </collision>
            <visual name="lower_feature_box_3_visual">
                <pose>1.2 -2.05 0.30 0 0 0</pose>
                <geometry>
                    <box><size>0.55 0.30 0.35</size></box>
                </geometry>
                <material>
                    <ambient>0.35 0.35 0.30 1</ambient>
                    <diffuse>0.75 0.75 0.60 1</diffuse>
                </material>
            </visual>

            <!-- 下侧特征 4：盒状凸起，x=4.4m，向通道内突出 0.10m -->
            <collision name="lower_feature_box_4_collision">
                <pose>4.4 -2.05 0.25 0 0 0</pose>
                <geometry>
                    <box><size>0.40 0.30 0.25</size></box>
                </geometry>
            </collision>
            <visual name="lower_feature_box_4_visual">
                <pose>4.4 -2.05 0.25 0 0 0</pose>
                <geometry>
                    <box><size>0.40 0.30 0.25</size></box>
                </geometry>
                <material>
                    <ambient>0.35 0.35 0.30 1</ambient>
                    <diffuse>0.75 0.75 0.60 1</diffuse>
                </material>
            </visual>

            <!-- ================= 上侧墙特征物 ================= -->
            <!-- 上侧特征 1：竖圆柱，x=-3.8m，半径 0.08m，向通道内突出 0.08m -->
            <collision name="upper_feature_cylinder_1_collision">
                <pose>-3.8 2.0 0.25 0 0 0</pose>
                <geometry>
                    <cylinder><radius>0.08</radius><length>0.25</length></cylinder>
                </geometry>
            </collision>
            <visual name="upper_feature_cylinder_1_visual">
                <pose>-3.8 2.0 0.25 0 0 0</pose>
                <geometry>
                    <cylinder><radius>0.08</radius><length>0.25</length></cylinder>
                </geometry>
                <material>
                    <ambient>0.30 0.35 0.30 1</ambient>
                    <diffuse>0.60 0.75 0.60 1</diffuse>
                </material>
            </visual>

            <!-- 上侧特征 2：盒状凸起，x=-0.4m，向通道内突出 0.10m -->
            <collision name="upper_feature_box_2_collision">
                <pose>-0.4 2.05 0.25 0 0 0</pose>
                <geometry>
                    <box><size>0.50 0.30 0.30</size></box>
                </geometry>
            </collision>
            <visual name="upper_feature_box_2_visual">
                <pose>-0.4 2.05 0.25 0 0 0</pose>
                <geometry>
                    <box><size>0.50 0.30 0.30</size></box>
                </geometry>
                <material>
                    <ambient>0.30 0.30 0.35 1</ambient>
                    <diffuse>0.60 0.60 0.75 1</diffuse>
                </material>
            </visual>

            <!-- 上侧特征 3：盒状凸起，x=2.8m，向通道内突出 0.10m -->
            <collision name="upper_feature_box_3_collision">
                <pose>2.8 2.05 0.25 0 0 0</pose>
                <geometry>
                    <box><size>0.40 0.30 0.25</size></box>
                </geometry>
            </collision>
            <visual name="upper_feature_box_3_visual">
                <pose>2.8 2.05 0.25 0 0 0</pose>
                <geometry>
                    <box><size>0.40 0.30 0.25</size></box>
                </geometry>
                <material>
                    <ambient>0.30 0.30 0.35 1</ambient>
                    <diffuse>0.60 0.60 0.75 1</diffuse>
                </material>
            </visual>

            <!-- 上侧特征 4：竖圆柱，x=5.0m，半径 0.08m，向通道内突出 0.08m -->
            <collision name="upper_feature_cylinder_4_collision">
                <pose>5.0 2.0 0.25 0 0 0</pose>
                <geometry>
                    <cylinder><radius>0.08</radius><length>0.25</length></cylinder>
                </geometry>
            </collision>
            <visual name="upper_feature_cylinder_4_visual">
                <pose>5.0 2.0 0.25 0 0 0</pose>
                <geometry>
                    <cylinder><radius>0.08</radius><length>0.25</length></cylinder>
                </geometry>
                <material>
                    <ambient>0.30 0.35 0.30 1</ambient>
                    <diffuse>0.60 0.75 0.60 1</diffuse>
                </material>
            </visual>
        </link>
    </model>
</sdf>
